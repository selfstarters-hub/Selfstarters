// Selfstarters Firestore rules.
// IMPORTANT: replace the email below with the founder/admin email before publishing.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email == 'ilyass@example.com';
    }
    function owner() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }

    // Public content
    match /clubs/{id} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum','ratingCount'])
        && request.resource.data.ratingCount == resource.data.ratingCount + 1
        && request.resource.data.ratingSum > resource.data.ratingSum
        && getAfter(/databases/$(database)/documents/reviews/$(id + '_' + request.auth.uid)).exists()
        && !get(/databases/$(database)/documents/reviews/$(id + '_' + request.auth.uid)).exists());
    }
    match /events/{id} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpCount'])
        && (request.resource.data.rsvpCount == resource.data.rsvpCount + 1
          || request.resource.data.rsvpCount == resource.data.rsvpCount - 1)
        && (
          (request.resource.data.rsvpCount == resource.data.rsvpCount + 1
            && getAfter(/databases/$(database)/documents/rsvps/$(id + '_' + request.auth.uid)).exists()
            && !get(/databases/$(database)/documents/rsvps/$(id + '_' + request.auth.uid)).exists())
          ||
          (request.resource.data.rsvpCount == resource.data.rsvpCount - 1
            && !getAfter(/databases/$(database)/documents/rsvps/$(id + '_' + request.auth.uid)).exists()
            && get(/databases/$(database)/documents/rsvps/$(id + '_' + request.auth.uid)).exists())
        ));
    }

    // Student profiles: users can create/read/update their own profile, but cannot self-promote.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == (request.auth.token.email == 'ilyass@example.com' ? 'admin' : 'student');
      allow update: if admin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role);
      allow delete: if admin();
    }

    // Applications and club pitches are student-created; only admins can moderate them.
    match /applications/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }
    match /clubPitches/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }

    // Reviews: one document per club/user, id must be clubId_userId.
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && id == request.resource.data.clubId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if false;
      allow delete: if admin();
    }

    // RSVP documents are private to the student, but event counters are admin/client managed only via transactions.
    match /rsvps/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && id == request.resource.data.eventId + '_' + request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow update: if false;
    }

    match /contactMessages/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if admin();
    }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
