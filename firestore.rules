rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    function isFounder(clubId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId))
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.founderId == request.auth.uid;
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // CLUBS
    match /clubs/{clubId} {
      allow read: if true;

      // Keep your existing club-creation code working.
      // For new clubs, your JavaScript should set founderId to request.auth.uid.
      allow create: if isAdmin();

      // Admins can do everything.
      // A founder can update their own club, but cannot change founderId
      // unless the new founder is already a member of that club.
      allow update: if isAdmin()
        || (
          isFounder(clubId)
          && (
            request.resource.data.founderId == resource.data.founderId
            || exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.resource.data.founderId))
          )
        );

      allow delete: if isAdmin();

      // CLUB MEMBERS
      match /members/{memberId} {
        // Members are visible on the club page.
        allow read: if true;

        // A student can join only as themselves.
        // The club filled count must increase by exactly one.
        allow create: if (
          isAdmin()
          || (
            signedIn()
            && memberId == request.auth.uid
            && !exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(memberId))
          )
        )
          && (
            isAdmin()
            || (
              request.resource.data.userId == request.auth.uid
              && request.resource.data.role == 'Member'
              && get(/databases/$(database)/documents/clubs/$(clubId)).data.filled < get(/databases/$(database)/documents/clubs/$(clubId)).data.total
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.filled
                   == get(/databases/$(database)/documents/clubs/$(clubId)).data.filled + 1
            )
          );

        // Founder can change roles. A normal member cannot edit their own role.
        allow update: if isAdmin() || isFounder(clubId);

        // A member can leave. Founder cannot remove themselves.
        // Founder/admin can remove another member.
        allow delete: if signedIn()
          && (
            (memberId == request.auth.uid
              && get(/databases/$(database)/documents/clubs/$(clubId)).data.founderId != request.auth.uid)
            || isFounder(clubId)
            || isAdmin()
          );
      }
    }

    // EVENTS
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // APPLICATIONS
    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // RSVPs
    match /rsvps/{rsvpId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // CLUB PITCHES
    match /clubPitches/{pitchId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }


    // EVENT PROPOSALS
    // Students can submit proposals. Only admins can review/manage them.
    match /eventPitches/{pitchId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // CONTACT MESSAGES
    match /contactMessages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
